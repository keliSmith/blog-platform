# =========================================
# Blog Platform - Environment Variables
# =========================================
# Copy this file to .env and adjust values.
#
#   cp .env.example .env
# =========================================

# --- App ---
APP_ENV=development
DEBUG=True
LOG_LEVEL=DEBUG
SECRET_KEY=change-me-to-random-string

# --- Database ---
# Leave empty to use SQLite (zero-config local dev, auto-creates dev.db).
# For MySQL, either:
#   DATABASE_URL=mysql+pymysql://blog_user:blog_password@127.0.0.1:3306/blog?charset=utf8mb4
# or configure the MYSQL_* variables below and leave DATABASE_URL empty.
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=blog_user
MYSQL_PASSWORD=blog_password
MYSQL_DATABASE=blog

# --- JWT ---
JWT_SECRET_KEY=change-me-to-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Upload (public asset base URL) ---
# Leave empty in local dev (uses the request host via the Vite proxy).
# In production set this to the public domain that serves /uploads, e.g.
#   UPLOAD_BASE_URL=https://api.yourblog.com
# so avatars/covers are returned as absolute https URLs.
UPLOAD_BASE_URL=

# --- Email notification backend ---
# "console" -> log the code to the server console (default, no deps).
# "smtp"     -> send a real email via SMTP (uses stdlib smtplib).
# 真实邮箱注册：启用 smtp 后端。以下示例为阿里云邮件推送 DirectMail；
# 若改用腾讯云 SES，把 SMTP_HOST 改为 smtp.qcloudmail.com（端口 465/587）。
# 发信地址（SMTP_USER/SMTP_FROM）需在控制台「发信域名/发信地址」中验证通过。
EMAIL_BACKEND=smtp
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com      # 阿里云 DirectMail「发信地址」/ 腾讯云 SES 发信地址
SMTP_PASSWORD=your_smtp_password      # 控制台生成的 SMTP 密码（非邮箱登录密码）
SMTP_FROM=noreply@yourdomain.com      # 必须与 SMTP_USER 一致（发信地址）
SMTP_USE_TLS=true

# --- SMS notification backend (real link via Aliyun) ---
# 个人开发者走 DYPNS 短信认证（免签名/模板）：SMS_PROVIDER=dypns
# （企业实名且已申请签名+模板时可用 SMS_PROVIDER=aliyun / DysmsAPI）
# 本地开发可保留 EXPOSE_DEV_CODE=True（上方）让验证码回显便于 UI 测试；
# 生产环境务必设 EXPOSE_DEV_CODE=False，验证码只经短信下发。
SMS_BACKEND=provider
SMS_PROVIDER=dypns
SMS_ACCESS_KEY=            # 阿里云 AccessKeyId（已授权 dypns:SendSmsVerifyCode 的 RAM 子账号）
SMS_SECRET=               # 阿里云 AccessKeySecret
# SignName / TemplateCode 填 DYPNS 控制台「赠送签名 / 模板」复制的真实值（个人免申请）。
SMS_SIGN_NAME=            # TODO: DYPNS 赠送签名名（控制台复制，勿用文档示例值）
SMS_REGION_ID=cn-hangzhou
SMS_TEMPLATE_CODE=        # TODO: DYPNS 赠送模板 CODE（控制台复制）
# Optional per-purpose template overrides (推荐，阿里云模板通常按用途区分):
# SMS_TEMPLATE_REGISTER=
# SMS_TEMPLATE_RESET=
# SMS_TEMPLATE_VERIFY=
SMS_TEMPLATE_PARAM_KEY=code
SMS_TIMEOUT=10
# 默认短信直连阿里云、不走 HTTP(S)_PROXY，避免本地 MITM 代理(Fiddler/Charles/
# mitmproxy/VPN)返回 403。若你的出网必须经过公司代理，改为 true。
SMS_USE_PROXY=false

# =========================================================
# Blog Platform - 生产环境变量模板
# 复制为 .env.prod 后修改, 然后运行 deploy.sh
#   cp .env.prod.example .env.prod
# =========================================================

# --- 域名与证书 (供 deploy.sh / nginx / certbot 使用) ---
# 你的站点域名, 需已解析(A记录)到 ECS 公网 IP
DOMAIN=inkmoth.icu
# 用于 Let's Encrypt 通知/证书到期提醒
EMAIL=__YOUR_EMAIL__

# --- App ---
APP_ENV=production
DEBUG=False
LOG_LEVEL=WARNING
# 以下两项若保持 __CHANGE_ME__, deploy.sh 会自动用 openssl 生成随机值
SECRET_KEY=__CHANGE_ME__
JWT_SECRET_KEY=__CHANGE_ME__
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- 数据库 (MySQL) ---
MYSQL_ROOT_PASSWORD=__CHANGE_ME_ROOT__
MYSQL_DATABASE=blog
MYSQL_USER=blog_user
MYSQL_PASSWORD=__CHANGE_ME_USER__

# --- 上传 (公开资源基址, deploy.sh 会自动设为 https://<DOMAIN>) ---
UPLOAD_BASE_URL=https://__YOUR_DOMAIN__
MAX_UPLOAD_SIZE=10485760

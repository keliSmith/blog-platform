# 首次部署使用的 HTTP 临时配置: 仅用于通过 ACME 校验 + 正常提供服务
# deploy.sh 会在申请到证书后替换为 default.conf.https 并 reload
server {
    listen 80;
    server_name {{DOMAIN_LIST}};

    # ACME HTTP-01 challenge (证书申请与续期都需要)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # API & 上传 -> 后端
    location /api/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 带 contenthash 的构建产物: 长缓存
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA (React) - 未知路径回退到 index.html, 入口不缓存
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
